# Caddy static server for Zuri Hotels — used by Railway (and any container host).
# Binds to the platform-provided $PORT (falls back to 80 for local runs).
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:80} {
	root * /srv
	encode zstd gzip

	# Keep URLs extensionless: bounce any explicit .html (and /index) to
	# the clean path with a permanent redirect.
	@indexpage path /index /index.html
	redir @indexpage / 301

	@htmlext path_regexp html ^/(.+)\.html$
	redir @htmlext /{re.html.1} 301

	# Clean URLs: /rooms -> rooms.html, / -> index.html. Unmatched paths
	# fall through to file_server, which returns a natural 404.
	try_files {path} {path}.html {path}/
	file_server

	# Images are the bulk of the bytes and rarely change — cache a week.
	@img path /assets/img/*
	header @img Cache-Control "public, max-age=604800"

	# Markup, CSS and JS must revalidate so a new deploy shows up right away.
	# Caddy sends ETags, so unchanged files still return a cheap 304.
	@dynamic not path /assets/img/*
	header @dynamic Cache-Control "no-cache"

	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
}
